<?xml version="1.0" encoding="utf-8"?>
<!-- 4x7 launcher entry; separate receiver + metadata is what produces a separate picker item.
     Some launchers cap the number of grid rows; the declared default size is still 4x7. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="s"
    android:targetCellWidth="4"
    android:targetCellHeight="7"
    android:minWidth="250dp"
    android:minHeight="460dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget"
    android:configure="dev.scriptable.android.WidgetConfigureActivity"
    android:previewImage="@drawable/widget_preview_4x7"
    android:widgetFeatures="reconfigurable"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description_4x7" />
