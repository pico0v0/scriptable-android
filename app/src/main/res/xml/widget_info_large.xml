<?xml version="1.0" encoding="utf-8"?>
<!-- 4x4 launcher entry; separate receiver + metadata is what produces a separate picker item. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="s"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget"
    android:configure="dev.scriptable.android.WidgetConfigureActivity"
    android:previewImage="@drawable/widget_preview_large"
    android:widgetFeatures="reconfigurable"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description_large" />
